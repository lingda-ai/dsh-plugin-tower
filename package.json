{
  "name": "dsh-plugin-tower",
  "version": "0.12.0",
  "description": "Tower: a local control tower for live agents in the right sidebar — goals, background jobs, schedules and the interventions they need.",
  "author": "LingDaAi (lingda-ai)",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/linzhengtong/dsh-plugin-tower.git"
  },
  "homepage": "https://gitee.com/linzhengtong/dsh-plugin-tower#readme",
  "bugs": {
    "url": "https://gitee.com/linzhengtong/dsh-plugin-tower/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs",
    "scripts",
    "test"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-better-sidebar",
    "agent",
    "supervision",
    "goal",
    "orchestration",
    "sidebar"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs --pack --tests ./test",
    "prepublishOnly": "node scripts/verify-artifact.mjs --pack --tests ./test"
  }
}
